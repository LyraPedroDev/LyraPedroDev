---
import { t } from '../../i18n/utils';

interface Props {
  lang: 'pt-BR' | 'en';
}

const { lang } = Astro.props;

// URLs das APIs com parâmetros de cores do tema Cyber Dark
const githubStatsUrl = "https://github-readme-stats.vercel.app/api?username=LyraPedroDev&theme=transparent&show_icons=true&bg_color=0D0E16&title_color=7C3AED&icon_color=06B6D4&text_color=E5E7EB&border_color=404060&hide_border=false";
const githubStreakUrl = "https://github-readme-streak-stats.herokuapp.com/?user=LyraPedroDev&theme=dark&background=0D0E16&ring=7C3AED&fire=FF006E&currStreakNum=06B6D4";
const githubLangsUrl = "https://github-readme-stats.vercel.app/api/top-langs?username=LyraPedroDev&theme=transparent&layout=compact&bg_color=0D0E16&title_color=7C3AED&text_color=E5E7EB&border_color=404060";
---

<section id="github-activity" class="py-24 px-6 relative z-10 max-w-6xl mx-auto fade-in-section">
  <!-- Cabeçalho da Seção -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 gap-4">
    <div>
      <span class="font-mono text-xs font-bold tracking-widest text-cyber-blue uppercase block mb-2.5">
        {t('github_section_badge', lang)}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {t('github_section_title', lang)}
      </h2>
    </div>
    <p class="max-w-xs text-gray-400 text-sm leading-relaxed">
      {t('github_section_desc', lang)}
    </p>
  </div>

  <!-- Grid Responsivo (1 col mobile, 2 col tablet, 3 col desktop) -->
  <div class="github-grid">
    <!-- Card 1: Stats Card -->
    <div class="card-container glass-card rounded-2xl overflow-hidden border border-white/5 p-4 flex items-center justify-center transition-all duration-300 hover:border-cyber-purple/30">
      <img
        src={githubStatsUrl}
        alt="GitHub Stats"
        class="w-full h-auto max-w-full rounded-xl loading-lazy shadow-[0_10px_30px_rgba(0,0,0,0.4)]"
        loading="lazy"
        width="450"
        height="195"
      />
    </div>

    <!-- Card 2: Streak Stats -->
    <div class="card-container glass-card rounded-2xl overflow-hidden border border-white/5 p-4 flex items-center justify-center transition-all duration-300 hover:border-cyber-purple/30">
      <img
        src={githubStreakUrl}
        alt="GitHub Streak"
        class="w-full h-auto max-w-full rounded-xl loading-lazy shadow-[0_10px_30px_rgba(0,0,0,0.4)]"
        loading="lazy"
        width="450"
        height="195"
      />
    </div>

    <!-- Card 3: Top Languages (Compact) -->
    <div class="card-container full-width glass-card rounded-2xl overflow-hidden border border-white/5 p-4 flex items-center justify-center transition-all duration-300 hover:border-cyber-purple/30">
      <img
        src={githubLangsUrl}
        alt="Top Languages"
        class="w-full h-auto max-w-full rounded-xl loading-lazy shadow-[0_10px_30px_rgba(0,0,0,0.4)]"
        loading="lazy"
        width="450"
        height="195"
      />
    </div>
  </div>
</section>

<style>
  .github-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  .card-container {
    background: rgba(13, 14, 22, 0.65);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .card-container img {
    max-width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .github-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .github-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    
    .card-container.full-width {
      grid-column: 1 / -1;
      justify-self: center;
      width: 100%;
      max-width: 450px; /* Mantém o alinhamento centralizado proporcional */
    }
  }
</style>
