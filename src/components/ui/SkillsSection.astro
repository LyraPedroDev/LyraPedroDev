---
import { t } from '../../i18n/utils';

interface Props {
  lang: 'pt-BR' | 'en';
}

const { lang } = Astro.props;

const categories = [
  {
    key: 'skills_cat_backend',
    skills: [
      { name: 'Python', levelKey: 'skills_level_senior', levelPercent: 90, descKey: 'skills_python_desc', status: 'senior' as const },
      { name: 'Flask', levelKey: 'skills_level_senior', levelPercent: 90, descKey: 'skills_flask_desc', status: 'senior' as const },
      { name: 'C#', levelKey: 'skills_level_intermediate', levelPercent: 65, descKey: 'skills_csharp_desc', status: 'intermediate' as const },
      { name: 'ASP.NET Core MVC', levelKey: 'skills_level_intermediate', levelPercent: 65, descKey: 'skills_aspnet_desc', status: 'intermediate' as const },
    ]
  },
  {
    key: 'skills_cat_frontend',
    skills: [
      { name: 'React', levelKey: 'skills_level_intermediate', levelPercent: 65, descKey: 'skills_react_desc', status: 'intermediate' as const },
      { name: 'TypeScript', levelKey: 'skills_level_intermediate', levelPercent: 65, descKey: 'skills_ts_desc', status: 'intermediate' as const },
      { name: 'Vanilla JS', levelKey: 'skills_level_senior', levelPercent: 90, descKey: 'skills_js_desc', status: 'senior' as const },
      { name: 'Tailwind CSS', levelKey: 'skills_level_senior', levelPercent: 90, descKey: 'skills_tailwind_desc', status: 'senior' as const },
    ]
  },
  {
    key: 'skills_cat_infra',
    skills: [
      { name: 'Linux', levelKey: 'skills_level_senior', levelPercent: 90, descKey: 'skills_linux_desc', status: 'senior' as const },
      { name: 'Automação (n8n & Bash)', levelKey: 'skills_level_intermediate', levelPercent: 65, descKey: 'skills_automation_desc', status: 'intermediate' as const },
      { name: 'CI/CD', levelKey: 'skills_level_beginner', levelPercent: 35, descKey: 'skills_cicd_desc', status: 'beginner' as const },
    ]
  }
];

const levelClasses = {
  senior: 'text-emerald-400 border-emerald-500/20 bg-emerald-500/5',
  intermediate: 'text-cyber-blue border-cyber-blue/20 bg-cyber-blue/5',
  beginner: 'text-cyber-purple border-cyber-purple/20 bg-cyber-purple/5'
};

const levelDots = {
  senior: 'bg-emerald-400',
  intermediate: 'bg-cyber-blue',
  beginner: 'bg-cyber-purple'
};
---

<section id="habilidades" class="py-24 px-6 relative z-10 max-w-6xl mx-auto fade-in-section">
  <!-- Cabeçalho da Seção -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 gap-4">
    <div>
      <span class="font-mono text-xs font-bold tracking-widest text-cyber-purple uppercase block mb-2.5">
        {t('skills_section_badge', lang)}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {t('skills_section_title', lang)}
      </h2>
    </div>
    <p class="max-w-xs text-gray-400 text-sm leading-relaxed">
      {t('skills_section_desc', lang)}
    </p>
  </div>

  <!-- Grid Responsivo por Categorias (1 col mobile, 3 col desktop) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    {categories.map(cat => (
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/5 flex flex-col justify-between h-full group/card relative">
        <!-- Minimal Border Glow on hover -->
        <div class="absolute inset-0 border border-white/0 rounded-2xl transition-colors duration-500 group-hover/card:border-white/10 pointer-events-none" aria-hidden="true"></div>

        <div>
          <!-- Título da Categoria -->
          <h3 class="font-display text-lg font-bold text-white mb-6 border-b border-white/5 pb-3">
            {t(cat.key, lang)}
          </h3>

          <!-- Lista de Skills -->
          <div class="space-y-6">
            {cat.skills.map(skill => (
              <div class="relative group/skill flex flex-col gap-2 p-3 sm:p-4 rounded-xl bg-white/2 border border-white/5 transition-all duration-300 hover:border-cyber-purple/20 hover:bg-white/3 select-none">
                <!-- Tooltip CSS-Only (Glow & Fade) -->
                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-1.5 bg-[#0D0E16] border border-white/10 rounded-lg text-[10px] font-mono font-medium text-gray-300 opacity-0 pointer-events-none group-hover/skill:opacity-100 transition-all duration-300 cubic-bezier(0.16, 1, 0.3, 1) shadow-[0_10px_30px_rgba(0,0,0,0.5)] whitespace-nowrap z-30">
                  {t(skill.descKey, lang)}
                  <!-- Tooltip Seta -->
                  <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-[#0D0E16] w-0 h-0"></div>
                </div>

                <!-- Cabeçalho da Skill -->
                <div class="flex items-center justify-between">
                  <span class="font-display font-semibold text-sm text-white group-hover/skill:text-cyber-purple transition-colors">
                    {skill.name}
                  </span>
                  
                  <!-- Badge de Nível Neon -->
                  <span class={`inline-flex items-center gap-1.5 font-mono text-[9px] font-bold px-2 py-0.5 rounded border ${levelClasses[skill.status]}`}>
                    <span class={`w-1 h-1 rounded-full ${levelDots[skill.status]} animate-pulse`}></span>
                    {t(skill.levelKey, lang)}
                  </span>
                </div>

                <!-- Barra de Progresso com Neon Glow em Hover -->
                <div class="w-full h-1.5 bg-white/5 rounded-full overflow-visible relative mt-1" aria-hidden="true">
                  <div
                    class="skill-bar-progress h-full rounded-full transition-all duration-500 ease-out"
                    style={`width: ${skill.levelPercent}%;`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Efeito de Brilho Neon e Escala na Barra de Progresso */
  .skill-bar-progress {
    background: linear-gradient(90deg, #7C3AED, #06B6D4);
    box-shadow: 0 0 5px #7C3AED;
    will-change: box-shadow, transform;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .group\/skill:hover .skill-bar-progress {
    box-shadow: 0 0 15px #06B6D4, inset 0 0 5px rgba(6, 182, 212, 0.3);
    transform: scaleY(1.2);
  }
</style>
