---
import { t } from '../../i18n/utils';

interface Props {
  lang?: 'pt-BR' | 'en';
}

const { lang = 'pt-BR' } = Astro.props;

const asciiBanner = `
  _                      ____            _       
 | |    _   _ _ __ __ _ | __ ) _ __ __ _(_)_ __  
 | |   | | | | '__/ _\` ||  _ \\| '__/ _\` | | '_ \\ 
 | |___| |_| | | | (_| || |_) | | | (_| | | | | |
 |_____|\\__, |_|  \\__,_||____/|_|  \\__,_|_|_| |_|
        |___/                                    
`;

const systemLogs = lang === 'pt-BR' ? [
  "[SYSTEM] LyraBrain AI Core inicializado com sucesso.",
  "[SYSTEM] Provedor: Claude 3.5 Sonnet executando em modo CLI local.",
  "[SYSTEM] Diretório Ativo: /home/pedro/documents/studies",
  "[SYSTEM] Integridade de rede ativa (Vozes de logs canalizadas via Whonix/Tor)."
] : [
  "[SYSTEM] LyraBrain AI Core initialized successfully.",
  "[SYSTEM] Model: Claude 3.5 Sonnet executing via local CLI.",
  "[SYSTEM] Working Directory: /home/pedro/documents/studies",
  "[SYSTEM] Network integrity secure (Log voices routed via Whonix/Tor)."
];
---

<div
  class="glass-card rounded-xl overflow-hidden border border-white/5 text-left font-mono text-xs shadow-2xl relative w-full"
>
  <!-- Cabeçalho do Terminal -->
  <div class="relative z-10 px-4 py-3 bg-[#0d0e16]/80 border-b border-white/5 flex items-center justify-between select-none">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-red-500/60 inline-block" aria-hidden="true"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-500/50 inline-block" aria-hidden="true"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-500/50 inline-block" aria-hidden="true"></span>
    </div>
    <span class="text-[10px] text-gray-500 tracking-wider">{t('term_tab_title', lang)}</span>
    <span class="text-[10px] text-gray-400 font-semibold">bash</span>
  </div>
  
  <!-- Corpo do Terminal com aria-live para acessibilidade WCAG AA -->
  <div
    id="terminal-body"
    class="relative z-10 p-5 space-y-3 bg-[#090A0F]/85 min-h-[350px] text-gray-300 overflow-y-auto leading-relaxed max-h-[400px] select-text"
  >
    <!-- Line 1: whoami -->
    <div class="flex items-center">
      <span class="text-cyber-blue font-bold mr-2 select-none">pedro@lyra-mint:~$</span>
      <span
        class="terminal-command text-white font-medium"
        style="--char-count: 6; animation: terminal-typing calc(var(--char-count) * 0.06s) steps(var(--char-count)) forwards, terminal-blink 0.5s step-end 1; animation-delay: 0.5s;"
      >whoami</span>
    </div>
    
    <!-- Output 1: whoami output -->
    <div
      class="terminal-output text-gray-400 pl-4 py-1 border-l-2 border-white/5 italic text-[11px]"
      style="animation: terminal-reveal 0.3s forwards; animation-delay: 1.0s; opacity: 0;"
    >
      <p aria-live="polite">
        {t('term_whoami_out', lang)}
      </p>
    </div>

    <!-- Line 2: cat sobre.txt -->
    <div
      class="flex items-center"
      style="animation: terminal-reveal-instant 0.1s forwards; animation-delay: 1.4s; opacity: 0;"
    >
      <span class="text-cyber-blue font-bold mr-2 select-none">pedro@lyra-mint:~$</span>
      <span
        class="terminal-command text-white font-medium"
        style=`--char-count: 13; animation: terminal-typing calc(var(--char-count) * 0.06s) steps(var(--char-count)) forwards, terminal-blink 0.5s step-end 2; animation-delay: 1.5s;`
      >{lang === 'pt-BR' ? 'cat sobre.txt' : 'cat about.txt'}</span>
    </div>

    <!-- Output 2: about me output -->
    <div
      class="terminal-output text-gray-400 pl-4 py-1 border-l-2 border-white/5 italic text-[11px]"
      style="animation: terminal-reveal 0.3s forwards; animation-delay: 2.5s; opacity: 0;"
    >
      <p aria-live="polite">
        {t('term_about_out', lang)}
      </p>
    </div>

    <!-- Line 3: lyrabrain --init -->
    <div
      class="flex items-center"
      style="animation: terminal-reveal-instant 0.1s forwards; animation-delay: 2.9s; opacity: 0;"
    >
      <span class="text-cyber-blue font-bold mr-2 select-none">pedro@lyra-mint:~$</span>
      <span
        class="terminal-command text-white font-medium"
        style="--char-count: 16; animation: terminal-typing calc(var(--char-count) * 0.06s) steps(var(--char-count)) forwards, terminal-blink 0.5s step-end 2; animation-delay: 3.0s;"
      >lyrabrain --init</span>
    </div>

    <!-- Output 3: banner & system logs -->
    <div
      class="terminal-output-container space-y-2"
      style="animation: terminal-reveal 0.4s forwards; animation-delay: 4.1s; opacity: 0;"
    >
      <pre class="text-cyber-purple font-bold text-[9px] leading-tight select-none py-2">{asciiBanner}</pre>
      <div class="text-emerald-400/90 font-mono text-[10px] pl-4 space-y-1 py-1.5 border-l border-emerald-500/20" aria-live="polite">
        {systemLogs.map(log => <p>{log}</p>)}
      </div>
    </div>

    <!-- Line 4: ./status.sh -->
    <div
      class="flex items-center"
      style="animation: terminal-reveal-instant 0.1s forwards; animation-delay: 4.6s; opacity: 0;"
    >
      <span class="text-cyber-blue font-bold mr-2 select-none">pedro@lyra-mint:~$</span>
      <span
        class="terminal-command text-white font-medium"
        style="--char-count: 11; animation: terminal-typing calc(var(--char-count) * 0.06s) steps(var(--char-count)) forwards, terminal-blink 0.5s step-end 2; animation-delay: 4.7s;"
      >./status.sh</span>
    </div>

    <!-- Output 4: status list -->
    <div class="terminal-output space-y-1 pl-4 py-1 text-[11px]" aria-live="polite">
      <p style="animation: terminal-reveal-instant 0.2s forwards; animation-delay: 5.6s; opacity: 0;">
        <span class="text-emerald-400 font-bold">[ OK ]</span> {t('term_status_1', lang).substring(6)}
      </p>
      <p style="animation: terminal-reveal-instant 0.2s forwards; animation-delay: 6.0s; opacity: 0;">
        <span class="text-emerald-400 font-bold">[ OK ]</span> {t('term_status_2', lang).substring(6)}
      </p>
      <p style="animation: terminal-reveal-instant 0.2s forwards; animation-delay: 6.4s; opacity: 0;">
        <span class="text-emerald-400 font-bold">[ OK ]</span> {t('term_status_3', lang).substring(6)}
      </p>
      <p style="animation: terminal-reveal-instant 0.2s forwards; animation-delay: 6.8s; opacity: 0;">
        <span class="text-emerald-400 font-bold">[ OK ]</span> {t('term_status_4', lang).substring(6)}
      </p>
    </div>

    <!-- Final empty active line with blinking cursor -->
    <div
      class="flex items-center"
      style="animation: terminal-reveal-instant 0.1s forwards; animation-delay: 7.2s; opacity: 0;"
    >
      <span class="text-cyber-blue font-bold mr-2 select-none">pedro@lyra-mint:~$</span>
      <span class="w-2 h-4 bg-cyber-blue animate-terminal-blink inline-block" aria-hidden="true"></span>
    </div>
  </div>
</div>
