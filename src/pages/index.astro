---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/ui/Terminal.astro';
import ProjectCard from '../features/projects/ProjectCard.astro';
import SkillsSection from '../components/ui/SkillsSection.astro';
import GithubActivity from '../components/ui/GithubActivity.astro';
import { t } from '../i18n/utils';

const lang = 'pt-BR';

const projects = [
  {
    id: 'ecochat',
    filename: 'ecochat.sh',
    theme: 'purple' as const,
    techs: ['Flask (Python)', 'React + Vite', 'SQLite'],
    github: 'https://github.com/LyraPedroDev/Projeto-PAP-2023-26-PedroLyra',
    categoryKey: 'project_pap_cat',
    prefix: 'eco'
  },
  {
    id: 'cinema',
    filename: 'cinema_mvc.cs',
    theme: 'blue' as const,
    techs: ['ASP.NET Core MVC', 'EF Core', 'C#'],
    github: 'https://github.com/LyraPedroDev/Cinema-Gabriel-Projeto-MVC-2025',
    categoryKey: 'project_academic_cat',
    prefix: 'cinema'
  },
  {
    id: 'lyrabrain',
    filename: 'brain.config',
    theme: 'purple' as const,
    techs: ['Claude Code', 'Automação', 'AI Assistant'],
    github: 'https://github.com/LyraPedroDev/LyraBrain',
    categoryKey: 'project_prod_cat',
    prefix: 'brain'
  }
];
---

<BaseLayout
  lang={lang}
  title="Pedro Lyra — Portfólio Pessoal"
  description="Espaço digital de Pedro Lyra. Jovem autodidata, curioso e apaixonado por segurança cibernética, Linux, automação e desenvolvimento backend."
>
  <!-- SYSTEM BOOT LOADER (Carregamento Premium) -->
  <div id="loader" class="fixed inset-0 z-[100] bg-[#090A0F] flex flex-col items-center justify-center transition-all duration-700 ease-in-out pointer-events-auto">
    <div class="flex flex-col items-center space-y-5 max-w-xs w-full px-6 text-center">
      <!-- Loader Cyber Orb -->
      <div class="relative w-16 h-16">
        <div class="absolute inset-0 rounded-full border-[3px] border-t-cyber-purple border-r-cyber-blue border-b-transparent border-l-transparent animate-spin"></div>
        <div class="absolute inset-2 rounded-full border border-t-cyber-blue border-r-transparent border-b-cyber-purple border-l-transparent animate-spin-reverse opacity-60"></div>
        <div class="absolute inset-4 rounded-full bg-gradient-to-br from-cyber-purple to-cyber-blue opacity-20 blur-sm"></div>
      </div>

      <!-- Texto de Status -->
      <div class="font-mono text-[10px] tracking-[0.2em] text-gray-400 uppercase flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-cyber-blue animate-pulse"></span>
        <span id="loader-text">{t('loader_initializing', lang)}</span>
      </div>

      <!-- Barra de Progresso -->
      <div class="w-full h-[2px] bg-white/5 rounded-full overflow-hidden relative">
        <div id="loader-progress" class="h-full bg-gradient-to-r from-cyber-purple to-cyber-blue w-0 transition-all duration-300 ease-out"></div>
      </div>
    </div>
  </div>

  <!-- HERO SECTION (Sobre Mim & Terminal) -->
  <header id="sobre" class="relative min-h-screen flex flex-col justify-center items-center pt-28 pb-16 px-6 z-10">
    <div class="max-w-4xl mx-auto text-center w-full">
      <!-- Badge Superior -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-500/20 bg-purple-500/5 text-[10px] font-mono font-bold tracking-widest text-purple-300 uppercase mb-8">
        {t('badge_header', lang)}
      </div>

      <!-- Tagline Principal -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.15] mb-8">
        <span class="text-gradient-custom bg-gradient-to-r from-white via-purple-300 to-cyan-300 text-transparent bg-clip-text inline-block">{t('hero_tagline_1', lang)}</span><br>
        <span class="bg-gradient-to-r from-cyber-purple to-cyber-blue text-transparent bg-clip-text" style="-webkit-background-clip: text;">
          {t('hero_tagline_2', lang)}
        </span>
      </h1>

      <!-- Descrição Principal -->
      <p class="max-w-2xl mx-auto text-gray-400 text-sm sm:text-base md:text-lg font-normal leading-relaxed mb-12 tracking-wide">
        {t('hero_desc', lang)}
      </p>

      <!-- Skill Set Tags -->
      <div class="max-w-xl mx-auto mb-16">
        <span class="block font-mono text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-4">
          {t('interests_title', lang)}
        </span>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-purple-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyber-purple"></span>
            Python & Flask
          </span>
          <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-cyan-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyber-blue"></span>
            React & TS
          </span>
          <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-purple-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyber-purple"></span>
            C# & ASP.NET MVC
          </span>
          <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-cyan-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyber-blue"></span>
            Linux Mint/Tails
          </span>
          <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-purple-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyber-purple"></span>
            Automação (n8n)
          </span>
        </div>
      </div>

      <!-- TERMINAL INTERATIVO -->
      <div class="max-w-2xl mx-auto w-full px-2 sm:px-4 fade-in-section">
        <Terminal lang={lang} />
      </div>
    </div>
  </header>

  <!-- SECÇÃO: PROJETOS CONCLUÍDOS -->
  <section id="projetos" class="py-24 px-6 relative z-10 max-w-6xl mx-auto fade-in-section">
    <!-- Cabeçalho da Seção -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 gap-4">
      <div>
        <span class="font-mono text-xs font-bold tracking-widest text-cyber-purple uppercase block mb-2.5">
          {t('section_projects_badge', lang)}
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          {t('section_projects_title', lang)}
        </h2>
      </div>
      <p class="max-w-xs text-gray-400 text-sm leading-relaxed">
        {t('section_projects_desc', lang)}
      </p>
    </div>

    <!-- Grid de Cards de Projetos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {projects.map(proj => (
        <ProjectCard
          id={proj.id}
          filename={proj.filename}
          theme={proj.theme}
          techs={proj.techs}
          github={proj.github}
          title={t(`${proj.prefix}_title`, lang)}
          description={t(`${proj.prefix}_desc`, lang)}
          details={t(`${proj.prefix}_details`, lang)}
          category={t(proj.categoryKey, lang)}
        />
      ))}
    </div>
  </section>

  <!-- SECÇÃO: HABILIDADES (TECH STACK) -->
  <SkillsSection lang={lang} />

  <!-- SECÇÃO: ATIVIDADE DO GITHUB -->
  <GithubActivity lang={lang} />

  <!-- SECÇÃO: EM DESENVOLVIMENTO -->
  <section id="desenvolvimento" class="py-24 px-6 relative z-10 max-w-6xl mx-auto fade-in-section">
    <!-- Cabeçalho -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 gap-4">
      <div>
        <span class="font-mono text-xs font-bold tracking-widest text-cyber-blue uppercase block mb-2.5">
          {t('section_dev_badge', lang)}
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white flex items-center gap-2.5">
          <span>{t('section_dev_title', lang)}</span> <span class="text-xl">🏗️</span>
        </h2>
      </div>
      <p class="max-w-xs text-gray-400 text-sm leading-relaxed">
        {t('section_dev_desc', lang)}
      </p>
    </div>

    <!-- Cards de Projetos em Progresso -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      <!-- Card 1: Feijoeiro Mágico -->
      <div class="glass-card rounded-xl p-6 sm:p-8 relative overflow-hidden group flex flex-col justify-between h-full">
        <!-- Border Beam SVG -->
        <svg class="border-beam-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <rect class="border-beam-rect stroke-cyber-cyan" x="0.5" y="0.5" width="99" height="99" rx="4" />
        </svg>

        <!-- Indicador de Status -->
        <div class="relative z-10 self-end flex items-center gap-1.5 font-mono text-[9px] text-cyber-pink bg-cyber-pink/10 px-2 py-0.5 rounded border border-cyber-pink/20">
          <span class="w-1.5 h-1.5 rounded-full bg-cyber-pink animate-pulse"></span>
          <span>{t('dev_tag_interfaces', lang)}</span>
        </div>

        <div class="relative z-10 mt-4">
          <h3 class="font-display text-lg font-bold text-white mb-2 group-hover:text-cyber-pink transition-colors pr-20">
            {t('feijoeiro_title', lang)}
          </h3>
          <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-6">
            {t('feijoeiro_desc', lang)}
          </p>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-white/5 mt-auto">
          <span class="font-mono text-[10px] text-gray-500">Tech: HTML, CSS, Vanilla JS</span>
          <a
            href="https://github.com/LyraPedroDev/FeijoeiroMagico"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={lang === 'pt-BR' ? "Acompanhar repositório do Feijoeiro Mágico no GitHub" : "Follow Feijoeiro Mágico repository on GitHub"}
            class="inline-flex items-center gap-1 text-xs font-mono font-medium text-cyber-blue hover:text-white transition-colors btn-interactive"
          >
            {t('dev_btn_repo', lang)}
          </a>
        </div>
      </div>

      <!-- Card 2: Casa Nossa Sra. de Fátima -->
      <div class="glass-card rounded-xl p-6 sm:p-8 relative overflow-hidden group flex flex-col justify-between h-full">
        <!-- Border Beam SVG -->
        <svg class="border-beam-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <rect class="border-beam-rect stroke-cyber-cyan" x="0.5" y="0.5" width="99" height="99" rx="4" />
        </svg>

        <!-- Indicador de Status -->
        <div class="relative z-10 self-end flex items-center gap-1.5 font-mono text-[9px] text-cyber-yellow bg-cyber-yellow/10 px-2 py-0.5 rounded border border-cyber-yellow/20">
          <span class="w-1.5 h-1.5 rounded-full bg-cyber-yellow animate-pulse"></span>
          <span>{t('dev_tag_structure', lang)}</span>
        </div>

        <div class="relative z-10 mt-4">
          <h3 class="font-display text-lg font-bold text-white mb-2 group-hover:text-cyber-yellow transition-colors pr-20">
            {t('casa_title', lang)}
          </h3>
          <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-6">
            {t('casa_desc', lang)}
          </p>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-white/5 mt-auto">
          <span class="font-mono text-[10px] text-gray-500">Tech: Arquitetura, Core</span>
          <a
            href="https://github.com/LyraPedroDev/CasaNossaSenhoraDeFatima"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={lang === 'pt-BR' ? "Acompanhar repositório da Casa Nossa Senhora de Fátima no GitHub" : "Follow Casa Nossa Senhora de Fátima repository on GitHub"}
            class="inline-flex items-center gap-1 text-xs font-mono font-medium text-cyber-blue hover:text-white transition-colors btn-interactive"
          >
            {t('dev_btn_repo', lang)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SCRIPT PARA CARREGAMENTO E SINCRONIZAÇÃO DO LOADER -->
  <script is:inline>
    (function() {
      let isLoaderFinished = false;
      let progressVal = 0;
      let progressInterval;

      const progressEl = document.getElementById('loader-progress');
      const loaderText = document.getElementById('loader-text');
      const loader = document.getElementById('loader');

      const updateProgress = () => {
        if (progressEl) progressEl.style.width = progressVal + '%';
      };

      const finishLoading = () => {
        if (isLoaderFinished) return;
        isLoaderFinished = true;

        if (progressInterval) clearInterval(progressInterval);
        progressVal = 100;
        updateProgress();

        if (loaderText) {
          const isEn = window.location.pathname.includes('/en');
          loaderText.textContent = isEn ? '[ SYSTEM READY ]' : '[ SISTEMA INICIALIZADO ]';
        }

        setTimeout(() => {
          if (loader) {
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              loader.style.display = 'none';
            }, 700);
          }
        }, 600);
      };

      progressInterval = setInterval(() => {
        if (progressVal < 90) {
          progressVal += Math.floor(Math.random() * 12) + 4;
          if (progressVal > 90) progressVal = 90;
          updateProgress();
        }
      }, 80);

      // Timeout failsafe
      setTimeout(() => {
        if (!isLoaderFinished) {
          finishLoading();
        }
      }, 2500);

      window.addEventListener('load', () => {
        if (!isLoaderFinished) {
          finishLoading();
        }
      });
    })();
  </script>
</BaseLayout>
